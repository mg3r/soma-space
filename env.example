# For local dev: get this from the output of npm run stripe:listen (starts with whsec_)
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: secret for signing guest waiver links (multi-ticket). Defaults to NEXTAUTH_SECRET or a fallback.
# WAIVER_GUEST_SECRET=your-secret-here

#EVENT_PASSWORD=your-event-password
#NEXT_PUBLIC_EVENT_NAME=soma space
#NEXT_PUBLIC_BASE_URL=https://entersoma.space
#NEXT_PUBLIC_STRIPE_BASE_URL=https://book.stripe.com/your-checkout-link
#STRIPE_SECRET_KEY_LIVE=sk_live_your_live_key_here
#STRIPE_SECRET_KEY_TEST=sk_test_your_test_key_here
#STRIPE_MODE=test
#ADMIN_PASSWORD=your-admin-password
#RESEND_API_KEY=re_your_resend_key_here
