# Example environment variables for local development
# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will not be committed

# Supabase Configuration (use test project for local dev)
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_test_service_role_key_here

# Stripe Configuration
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=sk_test_your_test_key_here
# For production, also set:
# STRIPE_SECRET_KEY_LIVE=sk_live_your_live_key_here

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_key_here
RESEND_FROM_EMAIL=ovi@entersoma.space

# Admin Authentication
ADMIN_PASSWORD=your_admin_password_here

# Event Password (for unlocking event details)
EVENT_PASSWORD=your_test_event_password_here

# Optional: Base URL for local development
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
